# =============================================================================
# VisionXAI Environment Variables Reference
# =============================================================================

# -----------------------------------------------------------------------------
# Backend Environment Variables (FastAPI)
# -----------------------------------------------------------------------------
# Port to listen on (Default: 8000)
PORT=8000

# Custom path to SQLite database file (Default: database/visionxai.db)
# In Docker or VPS, set to persistent volume path e.g. /app/database/visionxai.db
DATABASE_PATH=database/visionxai.db

# CORS Allowed Origins (comma-separated list, or * for all)
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Frontend Environment Variables (Vite - must start with VITE_)
# -----------------------------------------------------------------------------
# Backend API Base URL
# - Leave empty if served from the same domain/port via Docker or FastAPI
# - If frontend is hosted separately (e.g. Vercel), set to backend URL:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# (Optional) Supabase Cloud Database Configuration
# If configured, authentication and patient sync can connect to Supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOi...
